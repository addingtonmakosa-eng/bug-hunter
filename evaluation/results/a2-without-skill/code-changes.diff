@@ -40,27 +40,41 @@ class TransactionService:
     def average_transaction_value(self):
         """Average amount of the valid transactions."""
         valid = self.valid_transactions()
-        total = sum(tx["amount"] for tx in valid)
+        if not valid:
+            return 0.0
+        # Summing as floats: a sum of large ints cannot be added to a float.
+        total = sum(float(tx["amount"]) for tx in valid)
         return round_money(total / len(valid))
 
     def find_duplicates(self):
-        """Find transactions that repeat the id of an earlier transaction."""
+        """Find transactions that repeat the id of an earlier transaction.
+
+        The first record with a given id is the original and is not returned.
+        The store is left untouched.
+        """
         seen = set()
-        unique = []
+        duplicates = []
         for tx in self.valid_transactions():
-            if tx["id"] not in seen:
+            if tx["id"] in seen:
+                duplicates.append(tx)
+            else:
                 seen.add(tx["id"])
-                unique.append(tx)
-        self._transactions = unique
-        return unique
+        return duplicates
 
     def get_transaction(self, index):
-        """Return the record stored at the given position."""
+        """Return the record stored at the given zero-based position.
+
+        Returns None when the index is not an integer or is out of range.
+        """
+        if isinstance(index, bool) or not isinstance(index, int):
+            return None
+        if index < 0 or index >= len(self._transactions):
+            return None
         return self._transactions[index]
 
     def total_valid_transactions(self):
         """Net total of the valid transactions."""
         total = 0.0
         for tx in self.valid_transactions():
-            total += abs(tx["amount"])
+            total += tx["amount"]
         return round_money(total)
