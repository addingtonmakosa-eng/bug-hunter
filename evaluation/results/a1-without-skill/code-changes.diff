@@ -5,6 +5,23 @@ import math
 REQUIRED_FIELDS = ("id", "amount", "currency")
 
 
+def _is_finite(number):
+    """True when an int or float is finite and representable as a float.
+
+    ``math.isfinite`` raises OverflowError for an int too large to convert to
+    a float. Amounts are floats, so such a value is treated as not finite.
+    """
+    try:
+        return math.isfinite(number)
+    except OverflowError:
+        return False
+
+
+def _is_currency_code(value):
+    """True for exactly three uppercase ASCII letters, for example ``USD``."""
+    return isinstance(value, str) and len(value) == 3 and all("A" <= char <= "Z" for char in value)
+
+
 def round_money(value):
     """Round a monetary value to two decimal places."""
     return round(float(value), 2)
